.hero {
  background: linear-gradient(120deg, var(--navy), #103778);
  color: #fff; border-radius: 16px; padding: 26px 28px;
  display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap;
  margin-bottom: 24px;
}
.hero-kicker { font-size: 11px; letter-spacing: .06em; color: #93c5fd; text-transform: uppercase; margin-bottom: 6px; }
.hero h1 { font-size: 26px; font-weight: 700; margin-bottom: 6px; }
.hero p { font-size: 13px; color: #dbeafe; }
.hero-stats { display: flex; gap: 12px; }
.hero-box {
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18);
  border-radius: 12px; padding: 14px 18px; min-width: 125px;
}
.hero-box strong { display: block; font-size: 22px; }
.hero-box span { font-size: 11px; color: #dbeafe; }

.winners-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px; }
.winner-card {
  background: var(--card); border: 1px solid var(--border); border-radius: 14px;
  padding: 22px 18px; text-align: center;
}
.big-circle {
  width: 54px; height: 54px; border-radius: 50%; margin: 0 auto 10px;
  display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;
}
.winner-badge {
  display: inline-block; background: #fef3c7; color: #b45309;
  font-size: 11px; font-weight: 700; padding: 2px 10px; border-radius: 999px; margin-bottom: 8px;
}

.bottom-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 18px; }
.btn-outline {
  display: block; text-align: center; margin-top: 14px; padding: 9px 14px;
  border-radius: 8px; border: 1px solid var(--border); color: var(--text); text-decoration: none; font-size: 13px; font-weight: 600;
}
.notice {
  margin-top: 18px; background: #fff; border: 1px solid var(--border); border-radius: 10px;
  padding: 12px 16px; font-size: 12px; color: var(--muted);
}

@media (max-width: 900px) { .winners-grid, .bottom-grid { grid-template-columns: 1fr; } }
