.header-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
.pill-ongoing { background: #dcfce7; color: #15803d; font-size: 12px; padding: 3px 10px; border-radius: 999px; font-weight: 600; }

.stats-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 18px; }
.stat-card { border-radius: 12px; padding: 18px 20px; border: 1px solid transparent; }
.tint-blue { background: #eff6ff; border-color: #dbeafe; }
.tint-amber { background: #fffbeb; border-color: #fef3c7; }
.tint-purple { background: #f5f3ff; border-color: #ede9fe; }
.stat-label { font-size: 12px; color: var(--muted); margin-bottom: 6px; }
.stat-value { font-size: 28px; font-weight: 700; }
.stat-sub { font-size: 12px; color: var(--muted); margin-top: 4px; }

.grid-2-1 { display: grid; grid-template-columns: 1.75fr 1fr; gap: 18px; }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.card-head h2 { font-size: 16px; font-weight: 700; }
.card-head span { font-size: 12px; color: var(--muted); }

.cand-row { margin-bottom: 16px; }
.cand-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 13px; }
.cand-left { display: flex; align-items: center; gap: 10px; }
.avatar-sm {
  width: 30px; height: 30px; border-radius: 50%; background: #e2e8f0;
  display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px;
}
.badge-lead { background: #fef3c7; color: #b45309; font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 600; }

@media (max-width: 900px) { .stats-3, .grid-2-1 { grid-template-columns: 1fr; } }
